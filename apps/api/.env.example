SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Admin control plane: long random string. Required for /api/admin/*.
# Generate: -join ((48..122) | Get-Random -Count 48 | % {[char]$_})
ADMIN_API_KEY=
# Easy student login roster: student-id:pin pairs, comma separated.
# Example: STUDENT_ACCOUNTS=rahim-01:1234,mina-02:5678
STUDENT_ACCOUNTS=
# Optional token secret (defaults to ADMIN_API_KEY). Set separately in production.
STUDENT_TOKEN_SECRET=
